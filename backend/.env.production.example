# SRBlogs production environment template.
# Copy to /etc/srblogs/backend.env or backend/.env on the server.
# Production MUST change ADMIN_PASSWORD and JWT_SECRET before starting the service.

APP_NAME=SRBlogs API
APP_ENV=production
DATA_DIR=/opt/srblogs/backend/data
PUBLIC_BASE_URL=https://example.com

ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET
JWT_EXPIRE_MINUTES=1440

# Production must list trusted origins only. Do not use *.
CORS_ORIGINS=https://example.com

# Upload limits are enforced by FastAPI and should match nginx client_max_body_size.
UPLOAD_DRIVER=local
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml

# Optional OSS image hosting placeholders. Keep secrets on the server only.
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=

# Optional AI providers. Frontend/admin builds must never contain API keys.
AI_A_BASE_URL=
AI_A_API_KEY=
AI_A_MODEL=
AI_B_BASE_URL=
AI_B_API_KEY=
AI_B_MODEL=

# Optional GitHub OAuth/Gitalk placeholders. Keep OAuth secrets on the server only.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
QQ_OAUTH_APP_ID=
QQ_OAUTH_APP_SECRET=

# Contact form SMTP. SMTP_PASSWORD should be an app authorization code
# (QQ Mail uses an SMTP authorization code, not the account login password).
CONTACT_MAIL_ENABLED=false
CONTACT_MAIL_TO=1363072460@qq.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM=

# Optional admin release update trigger. The command is server-side only and is
# never returned to frontend/admin public APIs. Keep disabled unless the deploy
# machine has a reviewed, reversible update script.
SRBLOGS_UPDATE_REPO=ShrinkShi/SRBlogs
SRBLOGS_UPDATE_ENABLED=false
SRBLOGS_UPDATE_COMMAND=
