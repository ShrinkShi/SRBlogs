APP_NAME=SRBlogs API
APP_ENV=development
DATA_DIR=backend/data
PUBLIC_BASE_URL=http://127.0.0.1:8000
SITE_START_TIME=
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET=please-change-this-secret
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174,http://localhost:5173,http://localhost:5174
UPLOAD_DRIVER=local
UPLOAD_MAX_SIZE=5242880
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/gif,image/webp,image/svg+xml,audio/mpeg,audio/wav,audio/ogg,audio/mp4,video/mp4,video/webm,video/quicktime
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
QQ_OAUTH_APP_ID=
QQ_OAUTH_APP_SECRET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

# Contact form SMTP. SMTP_PASSWORD should be an app authorization code
# (QQ Mail uses an SMTP authorization code, not the account login password).
CONTACT_MAIL_ENABLED=false
CONTACT_MAIL_TO=1363072460@qq.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=true
SMTP_FROM=

# Optional admin release update trigger. The command is server-side only and is
# never returned to frontend/admin public APIs. Keep disabled unless the deploy
# machine has a reviewed, reversible update script.
SRBLOGS_UPDATE_REPO=ShrinkShi/SRBlogs
SRBLOGS_UPDATE_ENABLED=false
SRBLOGS_UPDATE_COMMAND=
OSS_ENDPOINT=
OSS_PUBLIC_BASE_URL=
AI_A_BASE_URL=
AI_A_API_KEY=
AI_A_MODEL=
AI_B_BASE_URL=
AI_B_API_KEY=
AI_B_MODEL=
