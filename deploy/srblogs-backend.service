[Unit]
Description=SRBlogs FastAPI backend
After=network.target

[Service]
Type=simple
User=srblogs
Group=srblogs
WorkingDirectory=/opt/srblogs/backend
EnvironmentFile=/etc/srblogs/backend.env
Environment=APP_DIR=/opt/srblogs
Environment=BACKEND_DIR=/opt/srblogs/backend
ExecStart=/usr/bin/env bash /opt/srblogs/deploy/start-backend.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
