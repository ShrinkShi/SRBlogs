[Unit]
Description=SRBlogs FastAPI Service
After=network.target

[Service]
Type=simple
User=srblogs
WorkingDirectory=/opt/SRBlogs/backend
Environment="PATH=/opt/SRBlogs/backend/.venv/bin"
ExecStart=/opt/SRBlogs/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
